<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Cardapio Online</title>

    <link rel="stylesheet" href="estilo.css">
</head>

<body>

    <!-- CABEÇALHO -->
    <header>

        <div class="cabecalho">

            <h1>Cardapio Online</h1>

            <nav>
                <a href="#">Início</a>
                <a href="#">Produtos</a>
                <a href="#">Sobre</a>
                <a href="#">Contato</a>
            </nav>

        </div>

    </header>


    <!-- CONTEÚDO -->
    <main>

        <section class="produtos">

            <h2>Meus Produtos</h2>

            <div class="cards">

                <!-- CARD 1 -->
                <div class="card">

                    <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRq-AeM9xKL_3F80k37dZWN3ir7Y57Hc9aJuP8hR7tYqA&s=10"
                        alt="Paisagem">

                    <h3>Coxinha</h3>

                    <p>
                        Crocante por fora, cremosa por dentro e com aquele recheio de frango irresistível. Uma mordida e você já vai querer outra!
                    </p>

                </div>


                <!-- CARD 2 -->
                <div class="card">

                    <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQEbxD3-6qse3RjOw4aZE5D6UdjPKVSbzzN1pgWrDnmGw&s=10"
                        alt="Natureza">

                    <h3>Feijoada</h3>

                    <p>
                        Feijoada bem temperada, com carnes saborosas e aquele gostinho caseiro que dá água na boca. Perfeita para matar a fome!
                    </p>

                </div>


                <!-- CARD 3 -->
                <div class="card">

                    <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRbHHMeaF5jwST7FLNNuK1O9cRR1i49qta_xc8YDvRvOA&s=10"
                        alt="Praia">

                    <h3>Pão de Queijo</h3>

                    <p>
                        Quentinho, macio e cheio de queijo! O sabor perfeito para qualquer hora do dia

                </div>


                <!-- CARD 4 -->
                <div class="card">

                    <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQt2SAG1EH_aE-mSQ_1-eGau5VzUFiqrCCYCN6GTfQbXA&s=10"
                        alt="Montanha">

                    <h3>Pastel</h3>

                    <p>
                        Massa crocante, recheio caprichado e muito sabor em cada mordida. Escolha seu recheio e aproveite!
                    </p>

                </div>

            </div>

        </section>

    </main>


    <!-- RODAPÉ -->
    <footer>

        <p>Cardapio Online - 2026</p>

    </footer>

</body>

</html>
